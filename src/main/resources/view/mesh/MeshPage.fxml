<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.cmps.tetrahedron.graphics.ModelView?>
<StackPane styleClass="mesh-page" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.cmps.tetrahedron.view.mesh.MeshPage"
           stylesheets="@/style/mesh.css">
    <ModelView/>
    <VBox>
        <fx:include fx:id="navbar" source="/view/common/Navbar.fxml"/>
        <!-- Takes all the height between navbar and info panel: left toolbar uses it to decide if it fits -->
        <HBox styleClass="tool-bar-block" VBox.vgrow="ALWAYS" minHeight="0">
            <VBox alignment="CENTER_LEFT">
                <fx:include source="/view/mesh/component/LeftToolBar.fxml"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT">
                <fx:include source="/view/mesh/component/RightToolbar.fxml" resources="i18n/mesh-right-toolbar"/>
            </VBox>
        </HBox>
        <HBox styleClass="info-panel">
            <Region HBox.hgrow="ALWAYS"/>
            <HBox fx:id="progressContainer" styleClass="progress-container" spacing="10" visible="false" onMouseClicked="#onProgressClicked">
                <Label text="%mesh-status"/>
                <Label fx:id="meshStatus" styleClass="mesh-status"/>
            </HBox>
        </HBox>
    </VBox>
</StackPane>
