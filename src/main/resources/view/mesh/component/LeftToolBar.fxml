<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.cmps.tetrahedron.view.common.BaseLeftTolBar"
      stylesheets="@/style/left-toolbar.css"
      styleClass="instrument-sidebar"
      alignment="CENTER">

    <Button styleClass="button, button-selected" fx:id="cursor" onMouseClicked="#clickOnCursor">
        <graphic>
            <fx:include source="/icon/Cursor.fxml"/>
        </graphic>
    </Button>

    <Button styleClass="button" fx:id="topBottom" onMouseClicked="#clickOnTopBottom">
        <graphic>
            <fx:include source="/icon/TopBottom.fxml"/>
        </graphic>
    </Button>

    <Button styleClass="button" fx:id="leftRight" onMouseClicked="#clickOnLeftRight">
        <graphic>
            <fx:include source="/icon/LeftRight.fxml"/>
        </graphic>
    </Button>

    <Region styleClass="toolbar-separator"/>

    <!-- Shown when the toolbar fits the window, otherwise replaced by the views menu button -->
    <VBox fx:id="viewButtons" styleClass="view-buttons">
        <Button styleClass="button" fx:id="viewFront" focusTraversable="false" onMouseClicked="#clickOnViewFront">
            <graphic>
                <fx:include source="/icon/ViewFront.fxml"/>
            </graphic>
        </Button>

        <Button styleClass="button" fx:id="viewTop" focusTraversable="false" onMouseClicked="#clickOnViewTop">
            <graphic>
                <fx:include source="/icon/ViewTop.fxml"/>
            </graphic>
        </Button>

        <Button styleClass="button" fx:id="viewRight" focusTraversable="false" onMouseClicked="#clickOnViewRight">
            <graphic>
                <fx:include source="/icon/ViewRight.fxml"/>
            </graphic>
        </Button>

        <Button styleClass="button" fx:id="viewLeft" focusTraversable="false" onMouseClicked="#clickOnViewLeft">
            <graphic>
                <fx:include source="/icon/ViewLeft.fxml"/>
            </graphic>
        </Button>

        <Button styleClass="button" fx:id="viewIsometric" focusTraversable="false" onMouseClicked="#clickOnViewIsometric">
            <graphic>
                <fx:include source="/icon/ViewIsometric.fxml"/>
            </graphic>
        </Button>
    </VBox>

    <Button styleClass="button" fx:id="viewsMenu" focusTraversable="false" visible="false" managed="false"
            onMouseClicked="#clickOnViewsMenu">
        <graphic>
            <fx:include source="/icon/Views.fxml"/>
        </graphic>
    </Button>

    <Region styleClass="toolbar-separator"/>

    <Button styleClass="button" fx:id="colorPicker" onMouseClicked="#clickOnColorPicker">
        <graphic>
            <fx:include source="/icon/ColorPicker.fxml"/>
        </graphic>
    </Button>

    <Button styleClass="button" fx:id="publicationMode" onMouseClicked="#clickOnPublicationMode">
        <graphic>
            <fx:include source="/icon/Camera.fxml"/>
        </graphic>
    </Button>
</VBox>
